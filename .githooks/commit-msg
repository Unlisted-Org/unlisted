#!/bin/sh
# Refuse a commit whose message carries a Co-Authored-By or "generated with" line.
hooks=$(dirname "$0")
if ! "$hooks/check-commit-message" < "$1" >/tmp/unlisted-commit-msg.$$ 2>&1; then
  echo "commit-msg: refused, the message has an AI attribution line:" >&2
  cat /tmp/unlisted-commit-msg.$$ >&2
  rm -f /tmp/unlisted-commit-msg.$$
  echo "Remove the line and commit again. See CONTRIBUTING.md." >&2
  exit 1
fi
rm -f /tmp/unlisted-commit-msg.$$
