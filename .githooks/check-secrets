#!/usr/bin/env python3
"""Refuse secrets. Used by the pre-commit hook (staged files) and the pre-push hook (every
file changed by the commits being pushed). See CONTRIBUTING.md §2a.

  check-secrets --staged            files staged for the next commit
  check-secrets --commits SHA...    files added or modified by these commits
  check-secrets --all               every tracked file (a false-positive check)

Exits 1 and prints each finding (masked) if anything matches. Never prints a full secret."""
import math, re, subprocess, sys
from collections import Counter

NAME_RULES = [
    (re.compile(r"(^|/)\.env(\.[^/]*)?$"), ".env file (only .env.example may be committed)"),
    (re.compile(r"(^|/)[^/]*keypair[^/]*\.json$", re.I), "keypair file"),
    (re.compile(r"(^|/)id\.json$"), "Solana CLI key file (id.json)"),
]
ALLOWED_NAMES = re.compile(r"(^|/)\.env\.example$")

CONTENT_RULES = [
    (re.compile(r"\[\s*\d{1,3}(?:\s*,\s*\d{1,3}){63}\s*\]"), "Solana keypair (64-byte array)"),
    (re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----"), "PEM private key"),
    # a credential in a URL's query string, e.g. https://devnet.helius-rpc.com/?api-key=<key>
    (re.compile(r"[?&](?:api[-_]?key|apikey|access[-_]?token|auth[-_]?token|token|key)=(?P<v>[A-Za-z0-9._~-]{16,})", re.I), "credential in a URL"),
    (re.compile(r"\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{30,}|\bgithub_pat_[A-Za-z0-9_]{30,}"), "GitHub token"),
    (re.compile(r"\bsk-(?:ant-|proj-)?[A-Za-z0-9_-]{20,}"), "API secret key (sk-…)"),
    (re.compile(r"\bAKIA[0-9A-Z]{16}\b"), "AWS access key"),
    (re.compile(r"\bxox[abprs]-[A-Za-z0-9-]{10,}"), "Slack token"),
    # env-style: UPPER_SNAKE names ending in a secret word, assigned a literal (not $VAR or ${VAR})
    (re.compile(r"^\s*(?:export\s+)?[A-Z][A-Z0-9_]*(?:API_KEY|SECRET|SECRET_KEY|PASSWORD|ACCESS_TOKEN|AUTH_TOKEN|PRIVATE_KEY)\s*=\s*[\"']?(?P<v>[^\s\"'$][^\s\"']{15,})"),
     "secret assigned in env style"),
    # code/config: a key named exactly like a secret, given a quoted string literal
    (re.compile(r"(?i)[\"']?\b(?:api_?key|secret(?:_?key)?|password|private_?key)\b[\"']?\s*[:=]\s*[\"'](?P<v>[^\"'$]{16,})[\"']"),
     "secret-named literal"),
]
TOKEN = re.compile(r"(?<![A-Za-z0-9_])[a-z0-9_]{40,}(?![A-Za-z0-9_])")


def entropy(s):
    c = Counter(s); n = len(s)
    return -sum(v / n * math.log2(v / n) for v in c.values())


def key_shaped(t):
    """A long lowercase/digit/underscore token that looks random rather than like an identifier or a hash."""
    if re.fullmatch(r"[0-9a-f]+", t):
        return False  # hex digests (sha256 etc.)
    return entropy(t) >= 4.0 and sum(ch.isdigit() for ch in t) / len(t) >= 0.2


def mask(s):
    return f"<{len(s)} chars, masked>"


def git(*a):
    return subprocess.run(["git", *a], capture_output=True, check=True).stdout


def scan(path, blob):
    found = []
    for rx, why in NAME_RULES:
        if rx.search(path) and not ALLOWED_NAMES.search(path):
            found.append(f"{path}: {why}")
    if b"\0" in blob[:8000]:
        return found  # binary
    text = blob.decode("utf-8", "replace")
    for n, line in enumerate(text.splitlines(), 1):
        for rx, why in CONTENT_RULES:
            m = rx.search(line)
            if m:
                v = m.groupdict().get("v") if m.groupdict() else None
                if (why.startswith("secret") or why == "credential in a URL") and v and (v.startswith("$") or v.lower() in {"true", "false", "null", "none"}):
                    continue
                found.append(f"{path}:{n}: {why}: {mask(v or m.group(0))}")
        for m in TOKEN.finditer(line):
            if key_shaped(m.group(0)):
                found.append(f"{path}:{n}: key-shaped token: {mask(m.group(0))}")
    return found


def main():
    mode, rest = (sys.argv[1] if len(sys.argv) > 1 else "--staged"), sys.argv[2:]
    items = []
    if mode == "--staged":
        for p in git("diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z").decode().split("\0"):
            if p:
                items.append((p, git("show", f":{p}")))
    elif mode == "--commits":
        for c in rest:
            for p in git("diff-tree", "--root", "--no-commit-id", "-r", "--name-only", "--diff-filter=ACMR", "-z", c).decode().split("\0"):
                if p:
                    items.append((f"{p} (commit {c[:9]})", git("show", f"{c}:{p}")))
    elif mode == "--all":
        for p in git("ls-files", "-z").decode().split("\0"):
            if p:
                try:
                    items.append((p, open(p, "rb").read()))
                except OSError:
                    pass
    else:
        sys.exit(f"unknown mode {mode}")
    findings = [f for p, b in items for f in scan(p, b)]
    for f in findings:
        print(f"  {f}", file=sys.stderr)
    sys.exit(1 if findings else 0)


if __name__ == "__main__":
    main()
