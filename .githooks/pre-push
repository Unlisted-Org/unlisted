#!/bin/sh
# Refuse a push if any commit being pushed has a Co-Authored-By or
# "generated with" line, an author/committer other than 1nonlypiece, or adds a secret.
remote="$1"
hooks=$(dirname "$0")
zero=0000000000000000000000000000000000000000
want_email='190412812+1nonlypiece@users.noreply.github.com'
fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue            # branch deletion
  if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    range="$local_sha --not --remotes=$remote"     # new branch, or remote tip unknown locally
  else
    range="$remote_sha..$local_sha"
  fi
  for c in $(git rev-list $range); do
    if ! git log -1 --format=%B "$c" | "$hooks/check-commit-message" >/dev/null; then
      echo "pre-push: $remote_ref: commit $c has an AI attribution line:" >&2
      git log -1 --format=%B "$c" | grep -n -i -E 'co-authored-by|generated with|🤖' | sed 's/^/    /' >&2
      fail=1
    fi
    if ! "$hooks/check-secrets" --commits "$c"; then
      echo "pre-push: $remote_ref: commit $c adds something that looks like a secret (listed above)" >&2
      fail=1
    fi
    ids=$(git log -1 --format='%an <%ae> / %cn <%ce>' "$c")
    if [ "$ids" != "1nonlypiece <$want_email> / 1nonlypiece <$want_email>" ]; then
      echo "pre-push: $remote_ref: commit $c has the wrong identity: $ids" >&2
      fail=1
    fi
  done
done
if [ "$fail" -ne 0 ]; then
  echo "pre-push: push refused. Fix the commits (see CONTRIBUTING.md) and push again." >&2
  exit 1
fi
exit 0
